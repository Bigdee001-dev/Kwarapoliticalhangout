{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://ajqzyygzgjrydxilzzto.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/article/:id",
      "has": [
        {
          "type": "header",
