        }
      ],
      "destination": "https://ajqzyygzgjrydxilzzto.supabase.co/functions/v1/render-article?id=:id"
    },
    {
      "source": "/sports/article/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Googlebot|Bingbot).*"
        }
      ],
      "destination": "https://ajqzyygzgjrydxilzzto.supabase.co/functions/v1/render-article?id=:id"
